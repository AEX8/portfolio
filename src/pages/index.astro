---
// Home: name on the left, solar system navigation on the right
import BaseLayout from '../layouts/BaseLayout.astro';
import BinaryName from '../components/BinaryName.astro';
import OrbitNav from '../components/orbit/OrbitNav.astro';
---

<BaseLayout active="home">
  <section class="hero">
    <div class="intro">
      <h1 class="name">
        <BinaryName text="Gayath" />
      </h1>
      <p class="role">
        RMIT <span class="sep" aria-hidden="true">/</span> Computer Science Graduate
      </p>
    </div>

    <div class="visual">
      <OrbitNav />
      <p class="tap-hint">Tap a planet to explore</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(24px, 5vh, 64px);
  }

  .intro {
    padding-left: clamp(20px, 2.5vw, 40px);
  }

  /* Small uppercase line under the name, left edge lined up with it */
  .role {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #ebe5da;
  }

  .sep {
    margin-inline: 0.5em;
    color: var(--accent);
  }

  .visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Hint for touch screens only (phones and tablets), hidden where there is a mouse */
  .tap-hint {
    display: none;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    text-transform: uppercase;
    color: #ebe5da;
  }

  @media (hover: none) and (pointer: coarse) {
    .tap-hint {
      display: block;
    }
  }

  /* Phones: labels hang below the lowest planets, so leave room */
  @media (max-width: 640px) {
    .tap-hint {
      margin-top: 44px;
    }
  }

  /* Stack on smaller screens */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-content: start;
      padding-top: 64px;
    }
  }

  /* Stacked: name and role line centred above the solar system */
  @media (max-width: 900px) {
    .intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-left: 0;
      text-align: center;
    }

    /* Letter spacing adds a gap after the last letter too; this pulls it back so the text sits truly centred */
    .role {
      margin-right: -0.24em;
    }
  }

  @media (max-width: 640px) {
    .role {
      font-size: 12px;
      letter-spacing: 0.16em;
      margin-right: -0.16em;
    }
  }
</style>
