---
// Contact: a signal emblem, availability, and one card per way to get in touch
import BaseLayout from '../layouts/BaseLayout.astro';
import { AVAILABILITY, DISCORD, EMAIL, GITHUB, LINKEDIN, LOCATION, TIME_ZONE } from '../data/contact';
---

<BaseLayout title="Contact" active="contact" description="Get in touch with Gayath: email, LinkedIn, GitHub and Discord.">
  <section class="page">
    <header class="head">
      <!-- A star sending out a signal -->
      <svg class="signal" viewBox="-60 -60 120 120" aria-hidden="true">
        <circle class="wave w0" r="14"></circle>
        <circle class="wave w1" r="14"></circle>
        <circle class="wave w2" r="14"></circle>
        <path class="core" d="M0 -16L1.6 -1.6L16 0L1.6 1.6L0 16L-1.6 1.6L-16 0L-1.6 -1.6Z"></path>
      </svg>

      <h1 class="heading">Contact</h1>
      <!-- Temporary caption, to be replaced -->
      <p class="intro">Send a signal. I'd love to hear from you.</p>

      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        {AVAILABILITY}
      </p>
    </header>

    <div class="grid">
      <!-- Email -->
      <article class="panel card">
        <div class="card-head">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
          </span>
          <h2 class="label">Email</h2>
        </div>
        <p class="value email">{EMAIL}</p>
        <div class="actions">
          <button class="action" type="button" data-copy={EMAIL}>
            <span data-copy-label>Copy</span>
          </button>
          <a class="action" href={`mailto:${EMAIL}`}>Send email <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <!-- LinkedIn -->
      <article class="panel card">
        <div class="card-head">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg>
          </span>
          <h2 class="label">LinkedIn</h2>
        </div>
        <p class="value">{LINKEDIN.handle}</p>
        <div class="actions">
          <a class="action" href={LINKEDIN.url} target="_blank" rel="noopener noreferrer">
            View profile <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </article>

      <!-- GitHub -->
      <article class="panel card">
        <div class="card-head">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" class="filled"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
          </span>
          <h2 class="label">GitHub</h2>
        </div>
        <p class="value">{GITHUB.handle}</p>
        <div class="actions">
          <a class="action" href={GITHUB.url} target="_blank" rel="noopener noreferrer">
            View code <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </article>

      <!-- Discord -->
      <article class="panel card">
        <div class="card-head">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="filled"><path d="M19.27 5.33A16.6 16.6 0 0 0 15.2 4l-.2.4a15.3 15.3 0 0 1 3.7 1.2 12.8 12.8 0 0 0-11.4 0A15.3 15.3 0 0 1 11 4.4L10.8 4a16.6 16.6 0 0 0-4.07 1.33C4.1 9.2 3.4 13 3.75 16.75A16.7 16.7 0 0 0 8.8 19.3l.65-1.05a10.8 10.8 0 0 1-1.7-.82l.4-.3a11.9 11.9 0 0 0 7.7 0l.4.3a10.8 10.8 0 0 1-1.7.82l.65 1.05a16.7 16.7 0 0 0 5.05-2.55c.42-4.35-.71-8.12-2.98-11.42zM9.35 14.5c-.97 0-1.77-.9-1.77-2s.78-2 1.77-2 1.79.9 1.77 2c0 1.1-.78 2-1.77 2zm5.3 0c-.97 0-1.77-.9-1.77-2s.78-2 1.77-2 1.79.9 1.77 2c0 1.1-.78 2-1.77 2z"></path></svg>
          </span>
          <h2 class="label">Discord</h2>
        </div>
        <p class="value discord">{DISCORD.username || (DISCORD.userId ? 'Message me on Discord' : 'Coming soon')}</p>
        <div class="actions">
          {
            DISCORD.username ? (
              <button class="action" type="button" data-copy={DISCORD.username} data-copy-what="Discord username">
                <span data-copy-label>Copy</span>
              </button>
            ) : (
              !DISCORD.userId && <span class="action action-soon">Coming soon</span>
            )
          }
          {
            DISCORD.userId && (
              <a class="action" href={`https://discord.com/users/${DISCORD.userId}`} target="_blank" rel="noopener noreferrer">
                Message <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </article>
    </div>

    <!-- Live local time in Melbourne -->
    <p class="clock" data-clock data-tz={TIME_ZONE}>
      <span>{LOCATION}</span>
      <span class="clock-face" aria-hidden="true">
        <span data-hh>--</span><span class="colon">:</span><span data-mm>--</span><span class="colon">:</span><span
          data-ss>--</span
        >
        <span data-zone>AEST</span>
      </span>
      <span class="sr-only" data-clock-text>Melbourne time</span>
      <span data-diff></span>
    </p>

    <!-- Announces "Copied" to screen readers -->
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </section>
</BaseLayout>

<script>
  // Copy the email address, with a short "Copied" confirmation
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  // Older copy method for browsers that block the clipboard API
  const legacyCopy = (text: string) => {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    area.remove();
    return ok;
  };

  // Last resort: highlight the address so the visitor can copy it
  const selectText = (el: Element | null) => {
    if (!el) return;
    const range = document.createRange();
    range.selectNodeContents(el);
    const sel = window.getSelection();
    sel?.removeAllRanges();
    sel?.addRange(range);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    const text = btn.dataset.copy ?? '';
    const what = btn.dataset.copyWhat ?? 'Email address';
    let timer: number | undefined;

    btn.addEventListener('click', async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        copied = legacyCopy(text);
      }

      if (copied) {
        label.textContent = 'Copied';
        if (status) status.textContent = `${what} copied`;
      } else {
        selectText(btn.closest('.card')?.querySelector('.value') ?? null);
        label.textContent = 'Selected';
        if (status) status.textContent = `${what} selected, ready to copy`;
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  });

  // Live digital clock in Melbourne time, ticking every second
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const tz = clock.dataset.tz ?? 'Australia/Melbourne';
    const hh = clock.querySelector<HTMLElement>('[data-hh]')!;
    const mm = clock.querySelector<HTMLElement>('[data-mm]')!;
    const ss = clock.querySelector<HTMLElement>('[data-ss]')!;
    const zone = clock.querySelector<HTMLElement>('[data-zone]')!;
    const diff = clock.querySelector<HTMLElement>('[data-diff]')!;
    const spoken = clock.querySelector<HTMLElement>('[data-clock-text]')!;

    const parts = new Intl.DateTimeFormat('en-AU', {
      timeZone: tz,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
      timeZoneName: 'short',
    });

    // Minutes between Melbourne and the visitor's own clock
    const offsetMinutes = (date: Date) => {
      const there = new Date(date.toLocaleString('en-US', { timeZone: tz }));
      const here = new Date(date.toLocaleString('en-US'));
      return Math.round((there.getTime() - here.getTime()) / 60000);
    };

    const tick = () => {
      const now = new Date();
      const p = Object.fromEntries(parts.formatToParts(now).map((x) => [x.type, x.value]));
      hh.textContent = p.hour;
      mm.textContent = p.minute;
      ss.textContent = p.second;
      zone.textContent = p.timeZoneName ?? '';

      // Only refresh the slower text once a minute
      if (p.second === '00' || !spoken.dataset.ready) {
        spoken.textContent = `Melbourne time is ${p.hour}:${p.minute}`;
        spoken.dataset.ready = '1';
        const off = offsetMinutes(now);
        const h = Math.abs(off) / 60;
        const hours = Number.isInteger(h) ? `${h}` : h.toFixed(1);
        diff.textContent =
          off === 0 ? 'Same time as you' : `${hours} ${h === 1 ? 'hour' : 'hours'} ${off > 0 ? 'ahead of' : 'behind'} you`;
      }
    };

    tick();
    // Line up with the start of each second so the digits change on time
    window.setTimeout(() => {
      tick();
      window.setInterval(tick, 1000);
    }, 1000 - (Date.now() % 1000));
  }
</script>

<style>
  .page {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    padding-block: clamp(32px, 6vh, 72px) clamp(48px, 8vh, 96px);
  }

  /* Centred header, same as the other pages */
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    margin-bottom: clamp(32px, 6vh, 56px);
  }

  /* Signal emblem: rings pulse out from a star */
  .signal {
    width: 96px;
    height: 96px;
    margin-bottom: 4px;
    overflow: visible;
  }

  .core {
    fill: #fcfaf5;
  }

  .wave {
    fill: none;
    stroke: var(--text);
    transform-box: fill-box;
    transform-origin: center;
    animation: wave 3.6s var(--ease) infinite;
  }

  .w1 { animation-delay: 1.2s; }
  .w2 { animation-delay: 2.4s; }

  @keyframes wave {
    from {
      transform: scale(1);
      stroke-opacity: 0.6;
    }
    to {
      transform: scale(3.6);
      stroke-opacity: 0;
    }
  }

  .heading {
    font-family: var(--font-mono);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .intro {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cdc6b9;
  }

  /* Availability chip */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: beacon 2.4s ease-out infinite;
  }

  @keyframes beacon {
    to {
      box-shadow: 0 0 0 8px transparent;
    }
  }

  /* Shared panel look */
  .panel {
    background: rgba(14, 16, 21, 0.82);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px;
    transition: border-color var(--slow) var(--ease), transform var(--slow) var(--ease);
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: #fcfaf5;
  }

  .icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon svg.filled {
    fill: currentColor;
    stroke: none;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .value {
    font-size: 16px;
    color: #e6dfd2;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }

  .action {
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fcfaf5;
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .action:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .action-soon {
    border-style: dashed;
    color: var(--text-muted);
    cursor: default;
  }

  .action-soon:hover {
    border-color: var(--line-strong);
    color: var(--text-muted);
  }

  /* Small one line clock under the cards */
  .clock {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    margin-top: clamp(28px, 5vh, 44px);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cdc6b9;
  }

  .clock > span:not(:first-child):not(.sr-only):not(:empty)::before {
    content: '·';
    margin-right: 14px;
    color: var(--text-muted);
  }

  .clock-face {
    font-variant-numeric: tabular-nums;
    color: #fcfaf5;
  }

  [data-zone],
  [data-diff] {
    color: var(--text-muted);
  }

  [data-zone] {
    margin-left: 0.6em;
  }

  /* Colons blink once a second */
  .colon {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .colon {
      animation: none;
    }
  }

  @media (max-width: 680px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
