---
// Me: a short personal story, interests, and a way to get in touch
import BaseLayout from '../layouts/BaseLayout.astro';
import { INTERESTS, MOTTO, STORY } from '../data/me';

// Four small planets on the emblem's orbit, one per interest
// Angles keep them clear of the disc in the middle
const moons = [40, 140, 220, 320].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { x: (Math.cos(a) * 58).toFixed(1), y: (Math.sin(a) * 20).toFixed(1) };
});
---

<BaseLayout title="Me" active="me" description="A little about Gayath: what I like building and what I'm into.">
  <section class="page">
    <header class="head">
      <!-- The ME sun from the homepage, with a small orbit around it -->
      <svg class="emblem" viewBox="-80 -50 160 100" aria-hidden="true">
        <g class="orbit">
          <ellipse rx="58" ry="20"></ellipse>
          {moons.map((m) => <circle class="moon" cx={m.x} cy={m.y} r="2.4" />)}
        </g>
        <circle class="disc-ring" r="26"></circle>
        <circle class="disc" r="20"></circle>
        <text class="disc-text" y="1">ME</text>
      </svg>

      <h1 class="heading">Me</h1>
      <p class="intro">A little about me.</p>
    </header>

    <!-- Story -->
    <article class="panel story">
      {STORY.map((p) => <p>{p}</p>)}
      <p class="motto">{MOTTO}</p>
    </article>

    <!-- Interests -->
    <section class="block" aria-labelledby="interests">
      <h2 class="block-title" id="interests">Things I'm into</h2>
      <ul class="interests">
        {
          INTERESTS.map((it) => (
            <li class="panel interest">
              <span class="i-icon" aria-hidden="true">
                {it.icon === 'space' && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="5" />
                    <ellipse cx="12" cy="12" rx="10.5" ry="3.6" transform="rotate(-20 12 12)" />
                  </svg>
                )}
                {it.icon === 'anime' && (
                  <svg viewBox="0 0 24 24">
                    {/* Cherry blossom: five notched petals around a small centre */}
                    {[0, 72, 144, 216, 288].map((r) => (
                      <path
                        d="M12 12C9.2 10.2 8.6 5.6 10.3 2.9L12 4.4l1.7-1.5c1.7 2.7 1.1 7.3-1.7 9.1z"
                        transform={`rotate(${r} 12 12)`}
                      />
                    ))}
                    <circle cx="12" cy="12" r="1.1" />
                  </svg>
                )}
                {it.icon === 'football' && (
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7.5l3.4 2.5-1.3 4h-4.2l-1.3-4zM12 7.5V3.2M15.4 10l4-1.4M14.1 14l2.6 3.4M9.9 14l-2.6 3.4M8.6 10l-4-1.4" />
                  </svg>
                )}
                {it.icon === 'gaming' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M7 8h10a4 4 0 0 1 4 4l-.6 4.2a2.4 2.4 0 0 1-4.2 1.2L14.5 15h-5l-1.7 2.4a2.4 2.4 0 0 1-4.2-1.2L3 12a4 4 0 0 1 4-4z" />
                    <path d="M8 10.5v3M6.5 12h3M15.5 11h.01M17.5 13h.01" />
                  </svg>
                )}
              </span>
              <span class="i-label">{it.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Contact -->
    <a class="panel cta" href="/contact">
      <span class="cta-text">Want to build something useful together?</span>
      <span class="cta-link">Get in touch <span aria-hidden="true">→</span></span>
    </a>
  </section>
</BaseLayout>

<style>
  .page {
    width: 100%;
    max-width: 820px;
    margin-inline: auto;
    padding-block: clamp(32px, 6vh, 72px) clamp(48px, 8vh, 96px);
  }

  /* Centred header, same as the other pages */
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    margin-bottom: clamp(32px, 6vh, 56px);
  }

  /* Emblem: the ME disc with four interest moons circling it */
  .emblem {
    width: 180px;
    height: 112px;
    margin-bottom: 4px;
    overflow: visible;
  }

  .orbit {
    transform: rotate(-14deg);
  }

  .orbit ellipse {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.3;
  }

  .moon {
    fill: var(--text);
    animation: glow 4s ease-in-out infinite;
  }

  .moon:nth-of-type(2) { animation-delay: 1s; }
  .moon:nth-of-type(3) { animation-delay: 2s; }
  .moon:nth-of-type(4) { animation-delay: 3s; }

  @keyframes glow {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }

  .disc {
    fill: #14171d;
    stroke: var(--text);
    stroke-opacity: 0.7;
  }

  .disc-ring {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.45;
  }

  .disc-text {
    fill: #fcfaf5;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .heading {
    font-family: var(--font-mono);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .intro {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cdc6b9;
  }

  /* Shared panel look */
  .panel {
    background: rgba(14, 16, 21, 0.82);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  /* Story */
  .story {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 4vw, 36px);
    font-size: 17px;
    line-height: 1.75;
    color: #e6dfd2;
  }

  /* The motto stands apart under a thin line */
  .motto {
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: clamp(15px, 1.8vw, 18px);
    letter-spacing: 0.06em;
    color: #fcfaf5;
  }

  /* Interests */
  .block {
    margin-top: clamp(40px, 7vh, 64px);
  }

  .block-title {
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
  }

  .interest {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 24px 12px 20px;
    transition: border-color var(--slow) var(--ease), transform var(--slow) var(--ease);
  }

  .interest:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .i-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: #fcfaf5;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .interest:hover .i-icon {
    color: var(--accent);
    border-color: var(--accent-muted);
  }

  .i-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .i-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  /* Contact link */
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: clamp(40px, 7vh, 64px);
    padding: 22px 26px;
    transition: border-color var(--slow) var(--ease);
  }

  .cta:hover {
    border-color: var(--accent-muted);
  }

  .cta-text {
    font-size: 16px;
    color: #e6dfd2;
  }

  .cta-link {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fcfaf5;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .cta:hover .cta-link {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Phones: interests two by two */
  @media (max-width: 640px) {
    .interests {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moon {
      animation: none;
    }
  }
</style>
