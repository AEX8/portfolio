---
// Education: a constellation timeline of milestones, then coursework and course projects
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyLogo from '../components/CompanyLogo.astro';
import { COURSE_GROUPS, COURSE_PROJECTS, COURSES_SHOWN, MILESTONES } from '../data/education';
import { PROJECTS } from '../data/projects';

const courseProjects = COURSE_PROJECTS.map((slug) => PROJECTS.find((p) => p.slug === slug)).filter(
  (p) => p !== undefined
);

// Course counts for the "Show all" button
const totalCourses = COURSE_GROUPS.reduce((n, g) => n + g.courses.length, 0);
const hiddenCount = COURSE_GROUPS.reduce((n, g) => n + Math.max(0, g.courses.length - COURSES_SHOWN), 0);

// Four point star used on the timeline
const star = (s: number) => {
  const w = s * 0.1;
  return `M0 ${-s}L${w} ${-w}L${s} 0L${w} ${w}L0 ${s}L${-w} ${w}L${-s} 0L${-w} ${-w}Z`;
};
---

<BaseLayout title="Education" active="education" description="Gayath's education: Bachelor of Computer Science at RMIT University.">
  <section class="page">
    <header class="head">
      <h1 class="heading">Education</h1>
      <p class="intro">All my studies.</p>
    </header>

    <!-- Milestones as stars joined into a constellation -->
    <ol class="timeline">
      {
        MILESTONES.map((m) => (
          <li class:list={['milestone', { main: m.main }]}>
            <span class="star" aria-hidden="true">
              <svg viewBox="-16 -16 32 32">
                {m.main && <circle class="star-ring" r="13" />}
                <path d={star(m.main ? 11 : 8)} />
              </svg>
            </span>
            <div class="panel">
              <div class="m-top">
                {m.logo && <CompanyLogo name={m.logo} alt={`${m.org} logo`} />}
                <div>
                  {m.period && <p class="period">{m.period}</p>}
                  <h2 class="m-title">{m.title}</h2>
                  <p class="org">{m.org}</p>
                </div>
              </div>
              {m.details.length > 0 && (
                <ul class="details">
                  {m.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Coursework grouped by skill; a few per group, the rest behind "Show all" -->
    <section class="block" aria-labelledby="coursework" data-courses>
      <h2 class="block-title" id="coursework">Coursework</h2>
      <div class="groups" id="course-groups">
        {
          COURSE_GROUPS.map((g) => (
            <div class="panel group">
              <h3 class="g-title">{g.name}</h3>
              {g.courses.length > 0 ? (
                <ul class="tags">
                  {g.courses.map((c, i) => (
                    <li class:list={{ extra: i >= COURSES_SHOWN }}>{c}</li>
                  ))}
                </ul>
              ) : (
                <p class="soon">Coming soon</p>
              )}
            </div>
          ))
        }
      </div>
      {
        hiddenCount > 0 && (
          <button class="show-all" type="button" aria-expanded="false" aria-controls="course-groups" data-show-all>
            <span data-label>Show all {totalCourses} courses</span>
            <span class="chev" aria-hidden="true">↓</span>
          </button>
        )
      }
    </section>

    <!-- Course projects, linking to their cards on the Projects page -->
    <section class="block" aria-labelledby="course-projects">
      <h2 class="block-title" id="course-projects">Course projects</h2>
      {
        courseProjects.length > 0 ? (
          <ul class="project-links">
            {courseProjects.map((p) => (
              <li>
                <a class="panel project-link" href={`/projects#${p.slug}`}>
                  <span class="p-title">{p.title}</span>
                  <span class="p-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="panel soon-panel">Coming soon</p>
        )
      }
    </section>
  </section>
</BaseLayout>

<script>
  // Show or hide the extra courses
  const section = document.querySelector<HTMLElement>('[data-courses]');
  const btn = section?.querySelector<HTMLButtonElement>('[data-show-all]');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  const total = label?.textContent ?? '';

  btn?.addEventListener('click', () => {
    const open = section!.classList.toggle('expanded');
    btn.setAttribute('aria-expanded', String(open));
    label!.textContent = open ? 'Show fewer' : total;
  });
</script>

<style>
  .page {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    padding-block: clamp(40px, 7vh, 80px) clamp(48px, 8vh, 96px);
  }

  /* Centred heading and caption, same as Projects */
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .heading {
    font-family: var(--font-mono);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .intro {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cdc6b9;
  }

  /* Shared panel look, matching the project cards */
  .panel {
    background: rgba(14, 16, 21, 0.82);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  /* Timeline: a thin line joining the stars */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    list-style: none;
    padding: 0 0 0 64px;
    margin-bottom: clamp(48px, 8vh, 80px);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 22px;
    top: 30px;
    bottom: 30px;
    width: 1px;
    background: linear-gradient(var(--line-strong), var(--line) 85%, transparent);
  }

  .milestone {
    position: relative;
  }

  .star {
    position: absolute;
    left: -58px;
    top: 18px;
    width: 32px;
    height: 32px;
  }

  .star svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .star path {
    fill: var(--text);
    opacity: 0.75;
  }

  .star-ring {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.4;
  }

  .main .star path {
    opacity: 1;
  }

  .milestone .panel {
    padding: 22px 26px;
  }

  .main .panel {
    border-color: var(--line-strong);
  }

  .period {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Logo tile beside the title, same as Experience */
  .m-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .m-title {
    font-family: var(--font-mono);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .org {
    margin-top: 4px;
    font-size: 15px;
    color: #cdc6b9;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 14px;
    padding: 14px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 15px;
    color: #e6dfd2;
  }

  /* Section blocks under the timeline */
  .block {
    margin-bottom: clamp(40px, 7vh, 64px);
  }

  .block-title {
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .group {
    padding: 20px 22px;
  }

  /* An odd last group spans the full row */
  .group:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .g-title {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Courses as a simple bullet list */
  .tags {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.5;
    color: #e6dfd2;
  }

  .tags li::marker {
    color: var(--text-muted);
  }

  /* Extra courses stay hidden until "Show all" */
  .tags .extra {
    display: none;
  }

  .expanded .tags .extra {
    display: list-item;
    animation: course-in 0.35s var(--ease) both;
  }

  @keyframes course-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .show-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 9px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fcfaf5;
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .show-all:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chev {
    transition: transform var(--slow) var(--ease);
  }

  .expanded .chev {
    transform: rotate(180deg);
  }

  .soon {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .soon-panel {
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .project-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
    padding: 0;
  }

  .project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fcfaf5;
    transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .project-link:hover {
    border-color: var(--line-strong);
    color: var(--accent);
  }

  /* Phones: one column, tighter timeline */
  @media (max-width: 640px) {
    .timeline {
      padding-left: 44px;
    }

    .timeline::before {
      left: 14px;
    }

    .star {
      left: -46px;
      width: 28px;
      height: 28px;
    }

    .groups,
    .project-links {
      grid-template-columns: 1fr;
    }
  }
</style>
