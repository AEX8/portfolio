---
// Shown by CloudFront for any page that doesn't exist
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="notfound">
    <p class="code" aria-hidden="true">ERR_404</p>
    <h1 class="title">Page not found</h1>
    <p class="note">The page you are looking for does not exist or has moved.</p>
    <a class="back" href="/">[01] Back to home</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 14px;
    padding-left: clamp(20px, 2.5vw, 40px);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
  }

  .note {
    color: var(--text-muted);
    max-width: 42ch;
  }

  .back {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 4px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .back:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
