---
// One project card: thumbnail, title, summary, tags and links.
// Cards with a write up open it in a pop-up when clicked.
import type { Project } from '../../data/projects';
import ProjectThumb from './ProjectThumb.astro';

interface Props {
  project: Project;
  hasDetails?: boolean;
  index?: number;
}

const { project, hasDetails = false, index = 0 } = Astro.props;

// Each card gets its shade on a different side, cycling so neighbours differ
const sides = ['left', 'corner', 'right', 'bottom'];
const side = project.shade ?? sides[index % sides.length];
---

<article
  class:list={['card', `shade-${side}`, { clickable: hasDetails }]}
  id={project.slug}
  data-card={project.slug}
>
  <ProjectThumb project={project} class="c-thumb" />

  <div class="body">
    <div class="title-row">
      <h2 class="title">{project.title}</h2>
      {project.status && <span class="status">{project.status}</span>}
    </div>
    {project.summary && <p class="summary">{project.summary}</p>}

    {
      project.tags.length > 0 && (
        <ul class="tags">
          {project.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }

    <div class="links">
      {
        project.github && (
          <a href={project.github} target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )
      }
      {
        project.live && (
          <a href={project.live} target="_blank" rel="noopener noreferrer">
            Live <span aria-hidden="true">↗</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )
      }
      {!project.github && !project.live && <span class="soon">Links coming soon</span>}
      {hasDetails && <span class="more" aria-hidden="true">Details +</span>}
    </div>
  </div>

  <!-- Covers the whole card; the GitHub and Live links sit above it -->
  {
    hasDetails && (
      <button class="open" type="button" data-open={project.slug} aria-haspopup="dialog">
        <span class="sr-only">Open details for {project.title}</span>
      </button>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(14, 16, 21, 0.82);
    border: 1px solid var(--line);
    border-radius: 16px;
    transition:
      border-color var(--slow) var(--ease),
      transform var(--slow) var(--ease);
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .card :global(.c-thumb) {
    position: relative;
    border-bottom: 1px solid var(--line);
    border-radius: 15px 15px 0 0;
  }

  /* A soft shade on one side of each thumbnail, fading out before the middle.
     The side varies per card; the shade melts away on hover. */
  .card :global(.c-thumb.fit-cover)::after,
  .card :global(.c-thumb.fit-contain)::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity var(--slow) var(--ease);
  }

  .shade-left :global(.c-thumb)::after {
    background: linear-gradient(90deg, rgba(6, 7, 10, 0.6), transparent 55%);
  }

  .shade-right :global(.c-thumb)::after {
    background: linear-gradient(270deg, rgba(6, 7, 10, 0.6), transparent 55%);
  }

  .shade-bottom :global(.c-thumb)::after {
    background: linear-gradient(0deg, rgba(6, 7, 10, 0.6), transparent 60%);
  }

  .shade-corner :global(.c-thumb)::after {
    background: radial-gradient(ellipse 80% 90% at 0% 100%, rgba(6, 7, 10, 0.62), transparent 70%);
  }

  /* Very light shade at the top and bottom only */
  .shade-edges :global(.c-thumb)::after {
    background: linear-gradient(
      180deg,
      rgba(6, 7, 10, 0.18),
      transparent 22%,
      transparent 78%,
      rgba(6, 7, 10, 0.18)
    );
  }

  .shade-none :global(.c-thumb)::after {
    display: none;
  }

  .card:hover :global(.c-thumb)::after {
    opacity: 0;
  }

  /* Gentle zoom on hover */
  .card:hover :global(.c-thumb img) {
    transform: scale(1.03);
  }

  .card:hover :global(.p-ring) {
    stroke: var(--accent);
    stroke-opacity: 0.9;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 22px 24px 24px;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fcfaf5;
  }

  .title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  /* Small pill for unfinished projects */
  .status {
    padding: 2px 10px;
    border: 1px solid var(--accent-muted);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .summary {
    font-size: 15px;
    line-height: 1.6;
    color: #cdc6b9;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .tags li {
    padding: 3px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Links sit at the bottom so cards in a row line up */
  .links {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .links a {
    position: relative;
    z-index: 2;
    color: #fcfaf5;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .soon {
    color: var(--text-muted);
  }

  /* Hint that the card opens, pushed to the right */
  .more {
    margin-left: auto;
    color: var(--text-muted);
    transition: color var(--fast) var(--ease);
  }

  .card.clickable:hover .more {
    color: var(--accent);
  }

  /* Invisible button over the whole card */
  .open {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 0;
    border-radius: 16px;
    background: none;
    cursor: pointer;
  }

  .open:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
</style>
