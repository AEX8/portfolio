---
// Project image, or a star chart placeholder with the project's initials.
// Used by the card and the pop-up so both always match.
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  class?: string;
  eager?: boolean;
}

const { project, class: className, eager = false } = Astro.props;

// Initials for the placeholder, e.g. "Smart Inventory" -> "SI"
const initials = project.title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

// A few stars placed from the slug, so each placeholder looks a little different
let seed = [...project.slug].reduce((n, c) => n * 31 + c.charCodeAt(0), 7) % 4294967296;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const stars = Array.from({ length: 14 }, () => ({
  x: (rand() * 320).toFixed(1),
  y: (rand() * 180).toFixed(1),
  r: (0.6 + rand() * 1.1).toFixed(1),
}));
const tilt = (-20 + rand() * 40).toFixed(1);
---

<div
  class:list={[
    'thumb',
    project.image && `fit-${project.imageFit ?? 'cover'}`,
    project.imageBg && `bg-${project.imageBg}`,
    className,
  ]}
>
  {
    project.image ? (
      <img
        src={project.image}
        alt={`${project.title} preview`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <svg class="placeholder" viewBox="0 0 320 180" aria-hidden="true">
        {stars.map((s) => <circle class="p-star" cx={s.x} cy={s.y} r={s.r} />)}
        <ellipse class="p-orbit" cx="160" cy="90" rx="118" ry="34" transform={`rotate(${tilt} 160 90)`} />
        <circle class="p-ring" cx="160" cy="90" r="30" />
        <text class="p-initials" x="160" y="90">{initials}</text>
      </svg>
    )
  }
</div>

<style>
  /* 16 by 9 frame */
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d0f14;
  }

  .thumb img,
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--slow) var(--ease);
  }

  /* Logos: shown whole, with breathing room, on their own background colour */
  .fit-contain img {
    object-fit: contain;
    padding: 6% 10%;
  }

  .bg-white {
    background: #fefefe;
  }

  .bg-slate {
    background: #161c23;
  }

  .bg-black {
    background: #040506;
  }

  .p-star {
    fill: var(--text);
    opacity: 0.45;
  }

  .p-orbit,
  .p-ring {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.22;
  }

  .p-ring {
    stroke-opacity: 0.45;
    transition: stroke var(--slow) var(--ease), stroke-opacity var(--slow) var(--ease);
  }

  .p-initials {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-anchor: middle;
    dominant-baseline: central;
  }
</style>
